# Canonical production origin, for example https://your-domain.example
NEXT_PUBLIC_SITE_URL=

# Create an Incoming Webhook bound to channel C0C4Y776Z3J.
# Server only. Never add NEXT_PUBLIC_ to this name.
SLACK_FEEDBACK_WEBHOOK_URL=

# Optional bot challenge locally; required for feedback on Vercel production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public account identifiers, not credentials. Leave blank before AdSense approval.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=
NEXT_PUBLIC_ADSENSE_ENABLED=false
