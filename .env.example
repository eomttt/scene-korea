# Canonical production origin. Rebuild after changing this value.
NEXT_PUBLIC_SITE_URL=https://www.scene-trip.com

# Optional public ownership-verification values from the search provider.
# Use the meta-tag content value, not the complete HTML tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Create an Incoming Webhook bound to channel C0C4Y776Z3J.
# Server only. Never add NEXT_PUBLIC_ to this name.
SLACK_FEEDBACK_WEBHOOK_URL=

# Optional additional challenge. Vercel BotID protects the feedback endpoint by default.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public account identifiers, not credentials. Leave blank before AdSense approval.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=
NEXT_PUBLIC_ADSENSE_ENABLED=false
